{
  "name": "@pchalupa/simpool",
  "version": "0.1.1",
  "description": "Share a host's iOS simulators between several AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pchalupa/simpool.git"
  },
  "homepage": "https://github.com/pchalupa/simpool#readme",
  "keywords": [
    "ios",
    "simulator",
    "simctl",
    "ai-agents",
    "skills"
  ],
  "bin": {
    "simpool": "bin/simpool.js"
  },
  "files": [
    "bin",
    "README.md",
    "dist"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node -e \"for (const a of ['arm64','x64']) require('fs').accessSync('dist/simpool-darwin-'+a)\" || (echo 'run make npm first' && exit 1)"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "release-it": "^21.1.2"
  }
}
